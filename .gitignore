# ---------------------------------------------------------------------------
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.log
data/installed.lock
data/*.bak

# ---------------------------------------------------------------------------
# Legacy / local-only files
# ---------------------------------------------------------------------------
# Previous static version of the site, kept on disk only.
legacy-index.html

# Build artefacts and archives
*.zip

